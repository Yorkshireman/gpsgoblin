{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Explicit entries for the Node profiler and the Chakra CLI's system export.
  "entry": ["scripts/profileGpxPipeline.mjs", "scripts/chakraTheme.ts"],
  // Vendor assets copied by scripts/copyMapLibreWorker.mjs and loaded by URL.
  "ignoreFiles": [
    "public/maplibre/maplibre-gl-worker.mjs",
    "public/maplibre/maplibre-gl-shared.mjs"
  ]
}
