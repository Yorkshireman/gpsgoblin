{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpsgoblin",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false }
}
