{
  "name": "gpsgoblin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "benchmark:imports": "node scripts/benchmarkImports.mjs",
    "build": "next build",
    "dev": "concurrently --kill-others --names next,prettier \"next dev\" \"pnpm format:watch\"",
    "preview:hosting": "wrangler dev --local --port 4186",
    "deploy:check": "wrangler deploy --dry-run",
    "knip": "knip",
    "lint": "eslint",
    "prebuild": "node ./scripts/copyMapLibreWorker.mjs",
    "postbuild": "node ./scripts/writeSecurityHeaders.mjs",
    "predev": "node ./scripts/copyMapLibreWorker.mjs",
    "start": "next start",
    "test": "jest",
    "typography:preview": "node scripts/previewTypography.mjs",
    "typography:capture": "node scripts/captureTypography.mjs",
    "test:browser": "playwright test",
    "test:browser:hosting": "playwright test --config playwright.hosting.config.ts",
    "test:browser:compatibility": "playwright test --config playwright.compatibility.config.ts",
    "tsc": "tsc --noEmit",
    "profile:imports": "node --expose-gc scripts/profileGpxPipeline.mjs",
    "profile:browser-memory": "node scripts/profileBrowserMemory.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "format:watch": "onchange \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,scss,md,mdx,yaml,yml,html}\" --exclude-path .prettierignore --filter add --filter change --poll 200 --await-write-finish 200 -- prettier --write --ignore-unknown {{file}}"
  },
  "dependencies": {
    "@chakra-ui/charts": "^3.37.0",
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "brotli-wasm": "3.0.1",
    "maplibre-gl": "6.7.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "knip": "^6.35.1",
    "onchange": "7.1.0",
    "prettier": "3.9.6",
    "typescript": "^5",
    "wrangler": "4.131.1"
  },
  "packageManager": "pnpm@12.3.4"
}
